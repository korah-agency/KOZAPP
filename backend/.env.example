# Base de donnees (obligatoire)
# Local dev (Postgres classique) :
DATABASE_URL=postgresql+asyncpg://kozapp_app:change_me_kozapp_app_dev@localhost:5432/kozapp_dev
# Supabase (pooler asyncpg) :
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase (facultatif, uniquement si le client Supabase est utilise en plus de DATABASE_URL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API
# Verify token global (handshake du webhook au niveau de l'app Tech Provider)
WHATSAPP_VERIFY_TOKEN=mon_token_secret_de_verification
WHATSAPP_API_VERSION=v21.0
# App Secret Meta (Developer Portal > Parametres > Basique) : signe chaque
# webhook entrant (X-Hub-Signature-256). Sans elle en production, le webhook
# refuse toute requete (voir app/api/webhooks.py::_verify_signature).
WHATSAPP_APP_SECRET=
# Le token d'envoi et le phone_number_id sont propres a CHAQUE commercant
# (colonnes profiles.whatsapp_token / profiles.whatsapp_phone_number_id),
# pas des variables d'environnement globales.

# Agent IA (passerelle OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL_DEFAULT=google/gemini-2.5-flash-lite
AGENT_MODEL_PREMIUM=google/gemini-2.5-flash
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_SUMMARY_TRIGGER_MESSAGES=20

# Application
ENVIRONMENT=development
SECRET_KEY=change_me_generer_une_cle_longue_et_secrete
ALLOWED_ORIGINS=http://localhost:3000
